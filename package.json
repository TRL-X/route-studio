{
  "name": "route-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:ci",
    "test:ci": "node --test tests/ci/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:pack": "npm run desktop:build && electron-builder --publish never",
    "desktop:pack:dir": "npm run desktop:build && electron-builder --dir --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "desktop:compile": "node scripts/build-electron.mjs"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "cborg": "6.2.1",
    "electron-updater": "6.8.12",
    "fast-xml-parser": "5.11.2",
    "fit-file-parser": "6.2.3",
    "geotiff": "3.0.5",
    "lucide-react": "1.57.0",
    "maplibre-gl": "6.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/web-bluetooth": "0.0.22",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.5",
    "js-yaml": "4.3.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "main": "dist-electron/main.cjs",
  "description": "Route editor and file converter for TRL-X devices",
  "author": "TRL-X",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TRL-X/route-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/TRL-X/route-studio.git"
  }
}
